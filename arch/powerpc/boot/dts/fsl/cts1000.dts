#include <dt-bindings/gpio/gpio.h>
/include/ "p4080si-pre.dtsi"

/ {
	model = "svy,cts-1000";
	compatible = "fsl,P4080DS", "cyphre,bt1";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&mpic>;

	memory {
		device_type = "memory";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bman_fbpr: bman-fbpr {
			size = <0 0x1000000>;
			alignment = <0 0x1000000>;
		};
		qman_fqd: qman-fqd {
			size = <0 0x400000>;
			alignment = <0 0x400000>;
		};
		qman_pfdr: qman-pfdr {
			size = <0 0x2000000>;
			alignment = <0 0x2000000>;
		};
	};

	dcsr: dcsr@f00000000 {
		ranges = <0x00000000 0xf 0x00000000 0x01008000>;
	};

	bportals: bman-portals@ff4000000 {
		ranges = <0x0 0xf 0xf4000000 0x200000>;
	};

	qportals: qman-portals@ff4200000 {
		ranges = <0x0 0xf 0xf4200000 0x200000>;
	};

	soc: soc@ffe000000 {
		ranges = <0x00000000 0xf 0xfe000000 0x1000000>;
		reg = <0xf 0xfe000000 0 0x00001000>;

		spi@110000 {
			flash@0 {
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "spansion,s25sl12801", "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <40000000>; /* input clock */
				partition@u-boot {
					label = "u-boot";
					reg = <0x00000000 0x00100000>;
					read-only;
				};
				partition@kernel {
					label = "kernel";
					reg = <0x00100000 0x00500000>;
					read-only;
				};
				partition@dtb {
					label = "dtb";
					reg = <0x00600000 0x00100000>;
					read-only;
				};
				partition@fs {
					label = "file system";
					reg = <0x00700000 0x00900000>;
				};
			};
		};

		i2c@118000 {
			/* RCW EEPROM */
			eeprom@50 {
				compatible = "at24,24c64";
				reg = <0x50>;
			};
			/* SYS EEPROM */
			eeprom@57 {
				compatible = "at24,24c02";
				reg = <0x57>;
			};
		};

		i2c@118100 {
			rtc@68 {
				compatible = "dallas,ds3232";
				reg = <0x68>;
				interrupts = <0x1 0x1 0 0>;
			};
			hwmon@4c {
				compatible = "adt,adt7461";
				reg = <0x4c>;
			};
		};

		usb0: usb@210000 {
		};

		usb1: usb@211000 {
		};

		fman@400000 {
			ethernet@f0000 {
				phy-handle = <&phy10>;
				phy-connection-type = "xgmii";
			};

			mdio@f1000 {
				phy10: ethernet-phy@4 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x5>;
				};
				phy11: ethernet-phy@5 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x4>;
				};
			};
		};

		fman@500000 {
			ethernet@f0000 {
				phy-handle = <&phy11>;
				phy-connection-type = "xgmii";
			};
		};

		gpio@130000 {
			/* Allows powering off the system via GPIO signal. */
			gpio-halt@27 {
				compatible = "sgy,gpio-halt";
				gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;
				interrupts = <8 1 0 0>;
			};
		};
	};

	rio: rapidio@ffe0c0000 {
		/* Placeholder, will delete below */
	};

	lbc: localbus@ffe124000 {
		reg = <0xf 0xfe124000 0 0x1000>;
		ranges = <0 0 0xf 0xe8000000 0x08000000
			  3 0 0xf 0xffdf0000 0x00008000>;

		flash@0,0 {
			compatible = "cfi-flash";
			reg = <0 0 0x08000000>;
			bank-width = <2>;
			device-width = <2>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;

			/* 16M for kernel */
			partition@0 {
				label = "sgyboot-kernel";
				reg = <0x00000000 0x01000000>;
			};
			/* 64M for root fs */
			partition@1 {
				label = "sgyboot-initrd";
				reg = <0x01000000 0x04000000>;
			};
			/* 256K for FMan microcode */
			partition@2 {
				label = "fsl-fman-ucode";
				reg = <0x05000000 0x00040000>;
			};
			/* 256K for Device-tree */
			partition@3 {
				label = "device-tree";
				reg = <0x05040000 0x00040000>;
			};
			/* 128K for u-Boot environment */
			partition@4 {
				label = "u-boot-env";
				reg = <0x05080000 0x00020000>;
			};
			/* 128K Unused */

			/* 1Meg for splash screen in u-boot's UDL driver */
			partition@6 {
				label = "udl-splash";
				reg = <0x050c0000 0x00100000>;
			};

			/* ~44Megs Unused */

			/* 2.5M for u-Boot */
			partition@5 {
				label = "u-boot";
				reg = <0x07D80000 0x00280000>;
			};

			/* 128k block for hash to check secure boot (only uses 0x600 bytes) */
			partition@7 {
				label = "secboot-hash";
				reg = <0x07000000 0x00020000>;
			};

			/* The whole flash area */
			partition@20 {
				label = "whole";
				reg = <0x00000000 0x08000000>;
			};
		};

		board-control@3,0 {
			compatible = "fsl,p4080ds-fpga", "fsl,fpga-ngpixis";
			reg = <3 0 0x30>;
		};
	};

	pci0: pcie@ffe200000 {
		reg = <0xf 0xfe200000 0 0x1000>;
		ranges = <0x02000000 0 0xe0000000 0xc 0x00000000 0x0 0x20000000
			  0x01000000 0 0x00000000 0xf 0xf8000000 0x0 0x00010000>;
		pcie@0 {
			ranges = <0x02000000 0 0xe0000000
				  0x02000000 0 0xe0000000
				  0 0x20000000

				  0x01000000 0 0x00000000
				  0x01000000 0 0x00000000
				  0 0x00010000>;
		};
	};

	pci1: pcie@ffe201000 {
		reg = <0xf 0xfe201000 0 0x1000>;
		ranges = <0x02000000 0x0 0xe0000000 0xc 0x20000000 0x0 0x20000000
			  0x01000000 0x0 0x00000000 0xf 0xf8010000 0x0 0x00010000>;
		pcie@0 {
			ranges = <0x02000000 0 0xe0000000
				  0x02000000 0 0xe0000000
				  0 0x20000000

				  0x01000000 0 0x00000000
				  0x01000000 0 0x00000000
				  0 0x00010000>;
		};
	};

	pci2: pcie@ffe202000 {
		/* Placeholder, will delete below */
	};
};

/include/ "p4080si-post.dtsi"

/* All of this just removes devices that we don't have on BT1. For the most
 * part, this is dTSEC (1g network interfaces, since we have Broadcom). We
 * could just let the kernel probe all of these, but it skews things like
 * mac address assignment. */
/ {
	aliases {
		/delete-property/ ethernet0;
		/delete-property/ ethernet1;
		/delete-property/ ethernet2;
		/delete-property/ ethernet3;
		/delete-property/ ethernet5;
		/delete-property/ ethernet6;
		/delete-property/ ethernet7;
		/delete-property/ ethernet8;
		/delete-property/ sdhc;
		/delete-property/ pci2;
	};

	soc@ffe000000 {
		fman@400000 {
			/delete-node/ mdio@e1120;
			/delete-node/ mdio@e3120;
			/delete-node/ mdio@e5120;
			/delete-node/ mdio@e7120;

			port@90000 {
				compatible = "fsl,fman-v2-port-rx", "fsl,fman-port-10g-rx";
			};
		};
		fman@500000 {
			/delete-node/ mdio@e1120;
			/delete-node/ mdio@e3120;
			/delete-node/ mdio@e5120;
			/delete-node/ mdio@e7120;
			/delete-node/ mdio@f1000;

			port@90000 {
				compatible = "fsl,fman-v2-port-rx", "fsl,fman-port-10g-rx";
			};
		};

		/delete-node/ sdhc@114000;
	};

	/delete-node/ rapidio@ffe0c0000;
};

/delete-node/ &fman0_rx_0x08;
/delete-node/ &fman0_tx_0x28;
/delete-node/ &enet0;

/delete-node/ &fman0_rx_0x09;
/delete-node/ &fman0_tx_0x29;
/delete-node/ &enet1;

/delete-node/ &fman0_rx_0x0a;
/delete-node/ &fman0_tx_0x2a;
/delete-node/ &enet2;

/delete-node/ &fman0_rx_0x0b;
/delete-node/ &fman0_tx_0x2b;
/delete-node/ &enet3;

/delete-node/ &fman1_rx_0x08;
/delete-node/ &fman1_tx_0x28;
/delete-node/ &enet5;

/delete-node/ &fman1_rx_0x09;
/delete-node/ &fman1_tx_0x29;
/delete-node/ &enet6;

/delete-node/ &fman1_rx_0x0a;
/delete-node/ &fman1_tx_0x2a;
/delete-node/ &enet7;

/delete-node/ &fman1_rx_0x0b;
/delete-node/ &fman1_tx_0x2b;
/delete-node/ &enet8;

/delete-node/ &pci2;
