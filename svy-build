#!/bin/bash

target=

case "$1" in
bt4)
	target="$1"
	dtb="t4240mfcs"
	;;
jade)
	target="$1"
	dtb="cts1000"
	;;
*)
	echo "Pick one of jade or bt4" 1>&2
	exit 1
esac

cpus=`getconf _NPROCESSORS_ONLN`
nway=`echo "($cpus * 15) / 10" | bc`

dir="`pwd`/build-$target"
export MAKEFLAGS="O=$dir -j$nway ARCH=powerpc CROSS_COMPILE=powerpc-linux-gnu-"

if ! test -f "$dir/.config"; then
	test -d "$dir" || mkdir "$dir"
	cp "svy-configs/$target" "$dir/.config"
fi

make uImage
make ${dtb}.dtb
