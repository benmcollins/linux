#!/bin/bash
# Build configurations in svy-configs.
set +x
target=
tstamp=$(date "+%Y%m%d%H%M%S")
rev="Cyphre-BTv1-1"
describe=$(git describe)
svytop=.

case "$1" in
bt4)
	target="$1"
	dtb="t4240mfcs"
	image=uImage
	;;
ct1)
	export KDEB_CHANGELOG_DIST=xenial
	export KDEB_SOURCENAME=linux-cyphre
	export KDEB_PKGVERSION=$describe
	export KBUILD_IMAGE=arch/powerpc/boot/uImage
	export EMAIL="ben.collins@rig.net"
	export NAME="Benjamin Collins"
	target="$1"
	dtb="cts1000"
	image=bindeb-pkg
	;;
ct1-fw)
	target="$1"
	dtb="cts1000"
	image=uImage
	;;
svy-jade-fips|ct1-fips)
	export KDEB_CHANGELOG_DIST=xenial
	export KDEB_SOURCENAME=linux-cyphre
	export KDEB_PKGVERSION=$describe
	export KBUILD_IMAGE=arch/powerpc/boot/uImage
	export EMAIL="vihar.rai@rignet.com"
	export NAME="Vihar Rai"
	target="$1"
	dtb="cts1000"
	image=bindeb-pkg
	;;
ct1-fips-linux)
	if ! [ -d ../linux ]; then \
		cd ..
		git clone https://github.com/torvalds/linux.git
		cd -
	fi
	cd ../linux
	svytop=../svy_linux
	target="$1"
	dtb=""
	rev=$tstamp
	image=bindeb-pkg
	;;
ct1-fips-fw)
	target="$1"
	dtb="cts1000"
	image=uImage
	;;
*)
	echo "Pick one of ct1, ct1-fw, ct1-fips, ct1-fips-fw, ct1-fips-linux, svy-jade-fips, or bt4" 1>&2
	exit 1
esac

cpus=$(getconf _NPROCESSORS_ONLN)
nway=$(echo "($cpus * 15) / 10" | bc)
dir="$(pwd)/../build-$target"
export CONCURRENCY_LEVEL=$nway

MAKEFLAGS="O=$dir -j$nway -l$nway V=1 ARCH=powerpc EXTRAVERSION=-$rev "

arch=$(uname -m)
case "$arch" in
ppc*)
        ;;
*)
        MAKEFLAGS="${MAKEFLAGS} CROSS_COMPILE=powerpc-linux-gnu- "
esac

export MAKEFLAGS
echo "*** ${MAKEFLAGS}"

if ! test -f "$dir/.config"; then
	test -d "$dir" || mkdir "$dir"
	cp "$svytop/svy-configs/$target" "$dir/.config"
fi

make $image
[ -n "${dtb}" ] &&  make ${dtb}.dtb
