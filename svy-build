#!/bin/bash

target=
rev="JadeLives-3"
kver=$(make kernelversion)-$rev


case "$1" in
bt4)
	target="$1"
	dtb="t4240mfcs"
	image=uImage
	;;
ct1)
	export KDEB_CHANGELOG_DIST=trixie
	export KDEB_SOURCENAME=linux-jade
	export KDEB_PACKAGEEXT=jade
	export KDEB_PKGVERSION=$kver
	export KBUILD_IMAGE=arch/powerpc/boot/uImage
	export EMAIL="bcollins@kernel.org"
	export NAME="Ben Collins"
	target="$1"
	dtb="fsl/cts1000"
	image=bindeb-pkg
	;;
ct1-fw)
	target="$1"
	dtb="fsl/cts1000"
	image=uImage
	;;
*)
	echo "Pick one of ct1, ct1-fw, or bt4" 1>&2
	exit 1
esac

cpus=`getconf _NPROCESSORS_ONLN`
nway=`echo "($cpus * 15) / 10" | bc`
dir="`pwd`/build-$target"

MAKEFLAGS="O=$dir -j$nway ARCH=powerpc KERNELRELEASE=$kver"

arch=`uname -m`
case "`uname -m`" in
ppc*)
        ;;
*)
        MAKEFLAGS="${MAKEFLAGS} CROSS_COMPILE=powerpc-linux-gnu-"
esac

export MAKEFLAGS

if ! test -f "$dir/.config"; then
	test -d "$dir" || mkdir "$dir"
	cp "svy-configs/$target" "$dir/.config"
fi

make $image
make ${dtb}.dtb
